rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if user is part of an agreement
    function isAgreementParent(agreementId) {
      let agreement = get(/databases/$(database)/documents/agreements/$(agreementId)).data;
      return request.auth.uid == agreement.parent1Id || request.auth.uid == agreement.parent2Id;
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);

      // User's notifications
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow write: if isSignedIn() && isOwner(userId);
      }
    }

    // Agreements - both parents can read/write
    match /agreements/{agreementId} {
      allow read: if isSignedIn() && isAgreementParent(agreementId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isAgreementParent(agreementId);
      allow delete: if false; // Prevent deletion

      // Children subcollection
      match /children/{childId} {
        allow read: if isSignedIn() && isAgreementParent(agreementId);
        allow write: if isSignedIn() && isAgreementParent(agreementId);
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isSignedIn() && isAgreementParent(agreementId);
        allow create: if isSignedIn() && isAgreementParent(agreementId);
        allow update: if isSignedIn() && isAgreementParent(agreementId);
        allow delete: if false; // Prevent deletion, only status updates
      }

      // Balances subcollection
      match /balances/{balanceId} {
        allow read: if isSignedIn() && isAgreementParent(agreementId);
        allow write: if isSignedIn() && isAgreementParent(agreementId);
      }

      // Schedule swaps
      match /scheduleSwaps/{swapId} {
        allow read: if isSignedIn() && isAgreementParent(agreementId);
        allow create: if isSignedIn() && isAgreementParent(agreementId);
        allow update: if isSignedIn() && isAgreementParent(agreementId);
        allow delete: if false;
      }

      // Documents
      match /documents/{documentId} {
        allow read: if isSignedIn() && isAgreementParent(agreementId);
        allow create: if isSignedIn() && isAgreementParent(agreementId);
        allow update: if isSignedIn() && isAgreementParent(agreementId);
        allow delete: if isSignedIn() && isAgreementParent(agreementId);
      }
    }

    // Invites - can be read by anyone with the token, created by authenticated users
    match /invites/{inviteId} {
      allow read: if true; // Anyone with the link can read
      allow create: if isSignedIn();
      allow update: if true; // Allow accepting invite
      allow delete: if false;
    }

    // Notifications - global notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if false; // Only Cloud Functions can create
      allow update: if isSignedIn(); // Users can mark as read
      allow delete: if false;
    }
  }
}
